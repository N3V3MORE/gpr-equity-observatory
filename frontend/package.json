{
  "name": "gpr-observer-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "test:runtime": "node --test tests/*.test.cjs",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "checks": "npm run lint && npm run typecheck && npm run test:runtime",
    "snapshot:prepare": "node scripts/public-snapshot.cjs prepare",
    "snapshot:hashes": "node scripts/public-snapshot.cjs hashes",
    "snapshot:validate": "node scripts/public-snapshot.cjs validate",
    "snapshot:stage": "node scripts/public-snapshot.cjs stage",
    "snapshot:artifact": "node scripts/public-snapshot.cjs artifact",
    "build:public": "node scripts/build-artifact.cjs public",
    "build:test": "node scripts/build-artifact.cjs test",
    "test:publication": "npm run snapshot:validate -- --tracked",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "19.2.8",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "autoprefixer": "10.4.19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "postcss": "8.5.23",
    "tailwindcss": "3.4.6",
    "typescript": "5.6.3"
  }
}
